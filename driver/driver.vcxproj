<?xml version="1.0" encoding="utf-8"?>
<!--
  driver.vcxproj - MSBuild project for the KeyboardSimulator KMDF driver.

  Build (from a "Developer Command Prompt for VS", or CI):
      msbuild driver.vcxproj /p:Configuration=Release /p:Platform=x64

  Requires Visual Studio 2022 ("Desktop development with C++") and the
  Windows Driver Kit (WDK) for Windows 11.  The legacy WDK `build` tool
  (`build -cZ`) no longer ships with current WDKs, so MSBuild is the only
  supported build path.

  The driver version is injected as a preprocessor definition so it stays in
  sync with the release tag:
      msbuild driver.vcxproj /p:Configuration=Release /p:Platform=x64 ^
              /p:DriverVersion=1.2.3
-->
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{B1F0C2A4-9E7D-4C3B-8A21-5F6D7E8C9A0B}</ProjectGuid>
    <RootNamespace>KeyboardSimulator</RootNamespace>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>31</KMDF_VERSION_MINOR>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <!-- Overridable from the command line: /p:DriverVersion=1.2.3 -->
    <DriverVersion Condition="'$(DriverVersion)' == ''">1.0.0</DriverVersion>
    <!-- DriverVer date in the INF, MM/DD/YYYY; stampinf's -d. -->
    <DriverVersionDate Condition="'$(DriverVersionDate)' == ''">01/01/2026</DriverVersionDate>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <TargetName>keyboardsimulator</TargetName>
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>KMDF</DriverType>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion>
    <!--
      The INF declares CatalogFile=keyboardctl.cat, so pnputil will not install
      the package without a signed catalog next to it.  Inf2Cat generates that
      catalog during the build from the <Inf> item below, and TestSign makes the
      WDK toolset sign the .sys and the .cat with a self-signed test certificate
      and export the matching .cer.
    -->
    <SignMode>TestSign</SignMode>
    <EnableInf2cat>true</EnableInf2cat>
    <!--
      The in-build package verification runs InfVerif in Windows-Driver mode,
      which a class filter (a "primitive" driver with no [Manufacturer]/[Models])
      legitimately fails.  Verification is not what makes the driver installable;
      the signed catalog is.  Run `infverif /h keyboardctl.inf` by hand for the
      WHQL signature bar.
    -->
    <SkipPackageVerification>true</SkipPackageVerification>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props"
            Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')"
            Label="LocalAppDataPlatform" />
  </ImportGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <ExceptionHandling></ExceptionHandling>
      <PreprocessorDefinitions>_WIN64;WIN64=1;DRIVER_VERSION="$(DriverVersion)";%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>wdmsec.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="queue.c" />
    <ClCompile Include="inject.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="driver.h" />
  </ItemGroup>
  <ItemGroup>
    <!--
      The INF installs the filter and, crucially, adds it to the Keyboard class
      UpperFilters ahead of kbdclass.  It is built as a "primitive driver":
      there are no [Manufacturer]/[Models] sections, so it is installed with
      `pnputil /add-driver keyboardctl.inf /install` rather than bound to a device.
    -->
    <Inf Include="keyboardctl.inf">
      <!--
        Confusingly named: this metadata is stampinf's -v, the DriverVer VERSION.
        stampinf rewrites the INF's DriverVer line and drops the stamped copy in
        $(OutDir), which is the one that ships.  Without it every release would
        carry the same DriverVer and Windows would refuse to update an installed
        package.
      -->
      <TimeStamp>$(DriverVersion)</TimeStamp>
      <DateStamp>$(DriverVersionDate)</DateStamp>
    </Inf>
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" Condition="'$(ConfigurationType)'=='Driver'" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
